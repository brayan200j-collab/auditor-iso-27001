[importlinter]
root_package = auditor
include_external_packages = True

[importlinter:contract:layers]
name = Each module follows api|infrastructure -> application -> domain
type = layers
layers =
    api | infrastructure
    application
    domain
containers =
    auditor.shared
    auditor.identity
    auditor.companies
    auditor.evaluations
    auditor.documents
    auditor.checklist
    auditor.analysis
    auditor.review
    auditor.reports
    auditor.feedback
    auditor.audit
    auditor.metrics
    auditor.retention

[importlinter:contract:domain-pure]
name = Domain layers import no frameworks or infrastructure
type = forbidden
source_modules =
    auditor.shared.domain
    auditor.identity.domain
    auditor.companies.domain
    auditor.evaluations.domain
    auditor.documents.domain
    auditor.checklist.domain
    auditor.analysis.domain
    auditor.review.domain
    auditor.reports.domain
    auditor.feedback.domain
    auditor.audit.domain
    auditor.metrics.domain
    auditor.retention.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    pydantic
    pydantic_settings
    httpx
    fitz
    pymupdf
    weasyprint
    jinja2
    psycopg
    alembic
    structlog
    jwt
    slowapi
    yaml
    auditor.config
    auditor.container
    auditor.main

[importlinter:contract:application-framework-free]
name = Application layers never import SQLAlchemy, FastAPI or adapters
type = forbidden
source_modules =
    auditor.shared.application
    auditor.identity.application
    auditor.companies.application
    auditor.evaluations.application
    auditor.documents.application
    auditor.checklist.application
    auditor.analysis.application
    auditor.review.application
    auditor.reports.application
    auditor.feedback.application
    auditor.audit.application
    auditor.metrics.application
    auditor.retention.application
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    httpx
    fitz
    pymupdf
    weasyprint
    jinja2
    psycopg
    alembic
    jwt
    slowapi
    auditor.container
    auditor.main

[importlinter:contract:api-no-sql]
name = API layers contain no SQL and do not reach infrastructure
type = forbidden
source_modules =
    auditor.shared.api
    auditor.identity.api
    auditor.companies.api
    auditor.evaluations.api
    auditor.documents.api
    auditor.checklist.api
    auditor.analysis.api
    auditor.review.api
    auditor.reports.api
    auditor.feedback.api
    auditor.audit.api
    auditor.metrics.api
    auditor.retention.api
forbidden_modules =
    sqlalchemy
    psycopg
    auditor.container

[importlinter:contract:shared-independent]
name = Shared kernel does not depend on feature modules
type = forbidden
source_modules =
    auditor.shared
forbidden_modules =
    auditor.identity
    auditor.companies
    auditor.evaluations
    auditor.documents
    auditor.checklist
    auditor.analysis
    auditor.review
    auditor.reports
    auditor.feedback
    auditor.audit
    auditor.metrics
    auditor.retention

