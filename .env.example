# Copy to .env (or run `make env` with Supabase local running). Never commit real values.

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend (private; never sent to the browser)
APP_ENV=local                       # local | test | pilot | production
DATABASE_URL=                       # postgresql+psycopg://user:password@host:5432/db
TEST_DATABASE_URL=                  # local/CI only
SUPABASE_URL=                       # URL the API uses to reach Supabase (JWKS, Storage)
SUPABASE_INTERNAL_URL=              # docker-compose only: Supabase URL inside the Docker network
SUPABASE_PUBLIC_URL=                # Supabase URL as seen by the browser (signed URLs)
SUPABASE_JWT_ISSUER=                # e.g. https://<project>.supabase.co/auth/v1
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
ALLOWED_ORIGINS=http://localhost:3000
LLM_PROVIDER=fake                   # fake | groq | gemini
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDERS_ALLOWED_FOR_REAL_DATA=groq
LLM_MAX_CONCURRENCY=2
MAX_TOKENS_PER_CALL=2000
MAX_LLM_CALLS_PER_EVALUATION=80
MAX_EVALUATIONS_PER_COMPANY=10
EVIDENCE_TOP_K=5
RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_SECONDS=21600  # how often expired documents are purged
SIGNED_URL_TTL_SECONDS=120

# Development seed users (local only; `make env` generates random passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=
SEED_SME_EMAIL=
SEED_SME_PASSWORD=
SEED_SME_B_EMAIL=
SEED_SME_B_PASSWORD=
SEED_MENTOR_EMAIL=
SEED_MENTOR_PASSWORD=
